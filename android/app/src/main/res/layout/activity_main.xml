<?xml version="1.0" encoding="utf-8"?>
<!-- fitsSystemWindows keeps content clear of the status and navigation bars
     (Android 15 draws apps edge-to-edge by default). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <!-- ===== Header: title + connection status ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_robot"
                android:tint="@color/accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/status_offline" />

                <TextView
                    android:id="@+id/statusPillText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline"
                    android:textColor="@color/text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Connect ===== -->
        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="Connect to robot"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:paddingTop="6dp"
            android:text="Tap connect when the robot is powered on"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Everything below is dimmed until connected -->
        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Drive card ===== -->
            <LinearLayout style="@style/Card">

                <LinearLayout style="@style/JointRow">

                    <TextView
                        style="@style/CardTitle"
                        android:text="Drive" />

                    <TextView
                        android:id="@+id/speedPill"
                        style="@style/Pill"
                        android:text="Speed 180" />
                </LinearLayout>

                <!-- Round drive pad: hold an arrow to move, Stop in the middle -->
                <FrameLayout
                    android:layout_width="216dp"
                    android:layout_height="216dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_dpad">

                    <ImageButton
                        android:id="@+id/btnForward"
                        style="@style/DpadButton"
                        android:layout_gravity="top|center_horizontal"
                        android:contentDescription="Forward"
                        android:src="@drawable/ic_chevron_up" />

                    <ImageButton
                        android:id="@+id/btnLeft"
                        style="@style/DpadButton"
                        android:layout_gravity="start|center_vertical"
                        android:contentDescription="Spin left"
                        android:src="@drawable/ic_chevron_left" />

                    <ImageButton
                        android:id="@+id/btnRight"
                        style="@style/DpadButton"
                        android:layout_gravity="end|center_vertical"
                        android:contentDescription="Spin right"
                        android:src="@drawable/ic_chevron_right" />

                    <ImageButton
                        android:id="@+id/btnBack"
                        style="@style/DpadButton"
                        android:layout_gravity="bottom|center_horizontal"
                        android:contentDescription="Backward"
                        android:src="@drawable/ic_chevron_down" />

                    <Button
                        android:id="@+id/btnStop"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_stop"
                        android:fontFamily="sans-serif-medium"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="Stop"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </FrameLayout>

                <LinearLayout
                    style="@style/JointRow"
                    android:layout_marginTop="14dp">

                    <TextView
                        style="@style/JointLabel"
                        android:drawableStart="@drawable/ic_gauge"
                        android:text="Speed" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekSpeed"
                    style="@style/Slider"
                    android:layout_marginBottom="0dp"
                    android:max="255"
                    android:progress="180" />
            </LinearLayout>

            <!-- ===== Arm card ===== -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    style="@style/JointRow"
                    android:layout_marginBottom="8dp">

                    <TextView
                        style="@style/CardTitle"
                        android:text="Arm" />

                    <TextView
                        android:id="@+id/btnHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_home"
                        android:drawablePadding="4dp"
                        android:drawableTint="@color/accent"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:padding="4dp"
                        android:text="Home"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout style="@style/JointRow">
                    <TextView
                        style="@style/JointLabel"
                        android:drawableStart="@drawable/ic_rotate"
                        android:text="Base" />
                    <TextView
                        android:id="@+id/valueBase"
                        style="@style/Pill"
                        android:text="90°" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBase"
                    style="@style/Slider"
                    android:max="180"
                    android:min="0"
                    android:progress="90" />

                <LinearLayout style="@style/JointRow">
                    <TextView
                        style="@style/JointLabel"
                        android:drawableStart="@drawable/ic_shoulder"
                        android:text="Shoulder" />
                    <TextView
                        android:id="@+id/valueShoulder"
                        style="@style/Pill"
                        android:text="90°" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekShoulder"
                    style="@style/Slider"
                    android:max="165"
                    android:min="15"
                    android:progress="90" />

                <LinearLayout style="@style/JointRow">
                    <TextView
                        style="@style/JointLabel"
                        android:drawableStart="@drawable/ic_elbow"
                        android:text="Elbow" />
                    <TextView
                        android:id="@+id/valueElbow"
                        style="@style/Pill"
                        android:text="90°" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekElbow"
                    style="@style/Slider"
                    android:max="165"
                    android:min="15"
                    android:progress="90" />

                <LinearLayout style="@style/JointRow">
                    <TextView
                        style="@style/JointLabel"
                        android:drawableStart="@drawable/ic_gripper"
                        android:text="Gripper" />
                    <TextView
                        android:id="@+id/valueGrip"
                        style="@style/Pill"
                        android:text="30°" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekGrip"
                    style="@style/Slider"
                    android:layout_marginBottom="8dp"
                    android:max="120"
                    android:min="30"
                    android:progress="30" />

                <!-- Open / Close toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segment_track"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/btnOpen"
                        style="@style/SegmentItem"
                        android:text="Open" />

                    <TextView
                        android:id="@+id/btnClose"
                        style="@style/SegmentItem"
                        android:text="Close" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Replies from the robot ===== -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    style="@style/JointRow"
                    android:layout_marginBottom="6dp">

                    <TextView
                        style="@style/CardTitle"
                        android:text="Robot says" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_message"
                        android:tint="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/logText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:minLines="6"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ===== Shut the board down before switching the battery off ===== -->
            <Button
                android:id="@+id/powerOffButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="Power off robot"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
